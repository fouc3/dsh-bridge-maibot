{
  "manifest_version": 2,
  "id": "com.fouc3.dsh-harness",
  "version": "1.0.0",
  "name": "DSH Harness 桥接",
  "description": "通过宿主中转进程驱动本地 DeepSeek Harness：派活、续聊、按工作区列会话，干完主动汇报。",
  "author": {
    "name": "fouc3",
    "url": "https://github.com/fouc3"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/fouc3/dsh-bridge-maibot",
    "homepage": "https://github.com/fouc3/dsh-bridge-maibot",
    "documentation": "https://github.com/fouc3/dsh-bridge-maibot#readme",
    "issues": "https://github.com/fouc3/dsh-bridge-maibot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send_message",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
